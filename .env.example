# Settings for the OPTIONAL GitHub sandbox adapter (README "Optional: GitHub sandbox adapter",
# DECISIONS.md A1 note 2026-11-01). The default `docker compose up` needs none of this.
#
# Use:  cp .env.example .env.github   then fill in .env.github (git-ignored) and pass it only to
# the separate project:  docker compose -p accessflow-github --env-file .env.github ...
# Never commit .env.github, never paste the token anywhere else, never `export` these values.
# Employees' GitHub usernames are not configured here: the request form asks for them.

# Host port of the separate project, so it runs beside the default one on 8080.
ACCESSFLOW_PORT=8090

# Fine-grained personal access token. Resource owner: the sandbox organisation. Repository
# access: only the sandbox repository. Permissions: Administration: Read and write (Metadata:
# Read is added automatically). Expiry: 30 days or less. Revoke it on GitHub when done.
GITHUB_TOKEN=github_pat_REPLACE_ME

# owner/name of a PRIVATE repository in that organisation. The adapter refuses a public
# repository and the AccessFlow repository itself.
GITHUB_REPOSITORY=your-sandbox-org/demo-repository

# ID of the AccessFlow API tool created with the account identity "GitHub kullanıcı adı"
# (step 1 of the README). Leave the placeholder until that tool exists.
GITHUB_TOOL_ID=00000000-0000-0000-0000-000000000000
